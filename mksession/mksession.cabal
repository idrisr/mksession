cabal-version: 3.0
name:          mksession
version:       0.1.0.0
license:       MIT
build-type:    Simple

common warnings
  ghc-options:        -Wall
  default-language:   Haskell2010
  default-extensions:
    NoStarIsType
    QuasiQuotes
  build-depends:
    base
    , aeson
    , directory
    , filepath
    , optparse-applicative
    , yaml

executable mksession
  import:         warnings
  main-is:        Main.hs
  hs-source-dirs: app
  build-depends:
    , mksession

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    MkSession
    MkSessionUtils

  build-depends:
    , aeson
    , bytestring
    , neat-interpolation
    , text
    , yaml

  default-language: Haskell2010
